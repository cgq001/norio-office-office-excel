{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Office Excel authorized resource map",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "resources"
  ],
  "properties": {
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assetId",
          "url"
        ],
        "properties": {
          "assetId": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          },
          "mimeType": {
            "type": "string"
          },
          "width": {
            "type": "number",
            "minimum": 0
          },
          "height": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    }
  }
}
